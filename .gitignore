# Whitelist: ignore everything at the top level, then re-include what we track.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/bootstrap.sh
!/hypr
!/nvim
!/omarchy
!/dotfiles-sync

# systemd: track only our own unit, not omarchy-managed symlinks
!/systemd
/systemd/*
!/systemd/user
/systemd/user/*
!/systemd/user/dotfiles-sync.service

# Junk that should never be committed (applies everywhere)
*.bak
*.bak.*
*.omarchy-upgrade-*
